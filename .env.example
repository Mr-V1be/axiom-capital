NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://axiom:axiom@localhost:5432/axiom
JWT_SECRET=replace-with-at-least-32-random-characters
KEY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
VITE_API_URL=http://localhost:4000
VITE_DATA_MODE=demo

# Isolated Base Sepolia fork for risk-free Splits V2 integration tests.
# SPLITS_MODE=test_fork
# SPLITS_RPC_URL=http://127.0.0.1:8545
# SPLITS_DEPLOYER_PRIVATE_KEY=0x<64-hex-test-only-key>
# SPLITS_RECIPIENT_SEED=<random-test-only-secret>

# Production may use HTTP Basic authentication at both Nginx and API layers.
# AUTH_MODE=basic
# BASIC_AUTH_USERNAME=operator
# BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
# BASIC_AUTH_TENANT_ID=tenant_axiom
# BASIC_AUTH_ACTOR_ID=user_owner
